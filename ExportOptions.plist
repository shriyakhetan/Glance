<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Development export: installs on devices registered to your team.
	     Use "ad-hoc" for a wider internal circle, or "app-store-connect" for
	     TestFlight. Both need a paid Apple Developer account. -->
	<key>method</key>
	<string>development</string>
	<!-- Your 10-character Team ID, from developer.apple.com → Membership. -->
	<key>teamID</key>
	<string>REPLACE_WITH_YOUR_TEAM_ID</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>stripSwiftSymbols</key>
	<true/>
	<key>compileBitcode</key>
	<false/>
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
